#!/bin/sh
# Entry point of the Ratchet AppImage: points GTK at the bundled data
# (icons, GSettings schemas, image loaders), then starts the app.
HERE="$(dirname "$(readlink -f "$0")")"

export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$HERE/usr/share/glib-2.0/schemas"

# gdk-pixbuf wants absolute loader paths, and the mount point changes on
# every launch, so write a loader cache for this one. It is named after
# this PID, which the app keeps through exec; caches of apps that are gone
# get removed.
CACHE_DIR="${XDG_RUNTIME_DIR:-/tmp}/ratchet-appimage-$(id -u)"
mkdir -p "$CACHE_DIR"
for old in "$CACHE_DIR"/loaders-*.cache; do
    [ -e "$old" ] || continue
    pid="${old##*/loaders-}"
    kill -0 "${pid%.cache}" 2>/dev/null || rm -f "$old"
done
CACHE="$CACHE_DIR/loaders-$$.cache"
sed "s|@APPDIR@|$HERE|g" "$HERE/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache.in" > "$CACHE"
export GDK_PIXBUF_MODULEDIR="$HERE/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders"
export GDK_PIXBUF_MODULE_FILE="$CACHE"

exec "$HERE/usr/bin/ratchet" "$@"
